# Copy to .env ONLY for local runs. Never commit .env. In GitHub, set these as Settings → Secrets and variables → Actions.

# --- Secrets ---
BUFFER_API_KEY=            # publish.buffer.com/settings/api
BUFFER_TIKTOK_CHANNEL_ID=  # from: npm run buffer:discover
BUFFER_ORGANIZATION_ID=    # from: npm run buffer:discover

# Storage (Cloudflare R2 recommended: public bucket or custom domain)
S3_ENDPOINT=               # https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=        # https://pub-xxxx.r2.dev  or  https://media.yourdomain.com

NOTIFY_WEBHOOK_URL=        # optional: Slack/Discord webhook or https://ntfy.sh/<topic>

# --- Plain variables (not secret) ---
STORAGE_DRIVER=s3          # s3 | github-release
BRAND_HANDLE=@your.design.studio
CTA_TEXT=تحتاج تصميمًا مثل هذا؟ راسلني
POST_TIME_LOCAL=19:00
POST_TIMEZONE=Asia/Riyadh
APPROVAL_REQUIRED_COUNT=7
DRY_RUN=false
